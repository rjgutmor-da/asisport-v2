{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["vite/client"]
  },
  "include": [
    "src/features/alumnos/components/CombinarAlumnosModal.jsx",
    "src/features/alumnos/hooks/useAlumnos.js",
    "src/features/alumnos/hooks/useCumpleanos.js",
    "src/services/catalogosService.js",
    "src/services/cumpleanosService.js",
    "src/services/actividadService.js",
    "src/services/estadisticasService.js",
    "src/features/alumnos/utils/alumnoDeuda.js",
    "src/features/asistencias/hooks/useAsistencias.js",
    "src/features/estadisticas/hooks/useEstadisticas.js",
    "src/hooks/useAlumnosRealtime.js",
    "src/hooks/useAsistenciasQuery.js",
    "src/hooks/useAsistenciasRealtime.js",
    "src/hooks/useMasterData.js",
    "src/pages/Estadisticas.jsx",
    "src/pages/RegistroActividad.jsx",
    "src/services/alumnos.js",
    "src/services/asistencias.js"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
